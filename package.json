{
  "name": "surveymasterai",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @surveymasterai/web dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @surveymasterai/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "dotenv -e .env -- pnpm --filter @surveymasterai/database generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @surveymasterai/database migrate",
    "db:migrate:deploy": "dotenv -e .env -- pnpm --filter @surveymasterai/database migrate:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @surveymasterai/database seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @surveymasterai/database studio"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "typescript": "^5.6.3"
  }
}
