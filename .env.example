# --- Database ---
DATABASE_URL="postgresql://surveymaster:surveymaster_dev@localhost:5432/surveymasterai"

# --- Cache / Queue ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- AI Provider ---
# Supported: "dev" (deterministic offline generator, no key needed), "openai", "anthropic"
AI_PROVIDER="dev"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Payment Provider ---
# Supported: "dev" (auto-activates subscriptions, no charges), "stripe"
PAYMENT_PROVIDER="dev"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Object Storage (S3-compatible) ---
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION=""

# --- Email ---
EMAIL_PROVIDER="dev"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="SurveyMasterAI <no-reply@surveymasterai.com>"
